<!DOCTYPE html>
<html>

<head>
    <title>{{title}}</title>
    <style>
        .listing-container {
            margin: 5%;
        }

        a {
            color: rgb(18, 48, 41);
        }
        img {
            width: 40%;
            min-height: 50%;
            border-radius: 2%;
            margin-right: 10%;
            margin-bottom: 5%;
        }
        .car_list {
            list-style-type: none;
            font-weight: 500;
            font-size: larger;           
        }

        .car {
            margin-bottom: 5px;
            display: flex;
            align-items: flex-start;
        }

        .car_specs {
            margin-bottom: 10px;
            font-size: large;
            list-style-type: none;
        }

        .searchForm {
            width: 50%;
            margin-left: 25%;
            margin-right: 25%;
            font-weight: 600;
            font-size: 125%;
        }

        h1 {
            text-align: center;
            font-weight: 600;
            margin-bottom: 5%;
        }

    </style>
</head>
<body>
    <div class="listing-container">
        <h5 data-i18n="sort_results"></h5>
        <!-- form for sorting searching results -->
        <form id="sortOrderForm" action="/items/search" method="GET">
            <select id="sortOrder" name="sortOrder">
                <option value="car_id_desc" {{#if (eq sortOrder 'car_id_desc')}}selected{{/if}} data-i18n="newest_to_oldest"></option>
                <option value="car_id_asc" {{#if (eq sortOrder 'car_id_asc')}}selected{{/if}} data-i18n="oldest_to_newest"></option>
                <option value="price_asc" {{#if (eq sortOrder 'price_asc')}}selected{{/if}} data-i18n="price_low"></option>
                <option value="price_desc" {{#if (eq sortOrder 'price_desc')}}selected{{/if}} data-i18n="price_high"></option>
                <option value="mileage_asc" {{#if (eq sortOrder 'mileage_asc')}}selected{{/if}} data-i18n="mileage_low"></option>
                <option value="mileage_desc" {{#if (eq sortOrder 'mileage_desc')}}selected{{/if}} data-i18n="mileage_high"></option>
                <option value="model_year_desc" {{#if (eq sortOrder 'model_year_desc')}}selected{{/if}} data-i18n="year_new"></option>
                <option value="model_year_asc" {{#if (eq sortOrder 'model_year_asc')}}selected{{/if}} data-i18n="year_old"></option>
            </select>
            <button type="submit" data-i18n="filter"></button>
        </form>
        <br>
        <div id="carList"></div>
        <br>
        <h1 data-i18n="search_results"></h1>
        <!-- Show search results -->
        <ul class="car_list">
            {{#each items}}
            <div class="car">
                <img src={{this.image}}>
                <div class="car_specs">
                    <h3><a href="/items/{{this.car_id}}">{{this.brand_name}} {{this.model_name}}</a></h3>
                    <strong>ID:</strong> {{this.car_id}} <br>
                    <strong data-i18n="brand"></strong> {{this.brand_name}} <br>
                    <strong data-i18n="model"></strong> {{this.model_name}} <br>
                    <strong data-i18n="price"></strong> {{this.price}} <br>
                    <strong data-i18n="model_year"></strong> {{this.model_year}} <br>
                    <strong data-i18n="mileage"></strong> {{this.mileage}} <br>
                    <strong data-i18n="power_type"></strong><span data-i18n="power_types.{{this.power_type}}"></span><br>
                    <strong data-i18n="gearbox_type"></strong><span data-i18n="gearbox_types.{{this.gearbox_type}}"></span> <br>
                    
                    <br>
                </div>
            </div>
            {{/each}}
        </ul>
    </div>

    <div class="container mt-5">
        <h1 data-i18n="search_vehicles"></h1>
        <!-- Form for new search -->
        <form id="searchForm" action="/items/search" method="get" class="searchForm">
            <div class="form-group mx-sm-3 mb-2">
                <label for="brandSelect" data-i18n="select_brand"></label>
                <select id="brandSelect" name="brandSelect" class="form-control" multiple="multiple">
                    {{#each car_brand}}
                    <option value="{{this.brand_id}}">{{this.brand_name}}</option>
                    {{/each}}
                </select>

                <label for="modelSelect" data-i18n="select_model"></label>
                <select id="modelSelect" name="modelSelect" class="form-control" multiple="multiple">
                    {{#each car_model}}
                    <option value="{{this.model_id}}">{{this.model_name}}</option>
                    {{/each}}
                </select>

                <label for="minPrice" data-i18n="min_price"></label>
                <input type="number" id="minPrice" name="minPrice" class="form-control" min="0">

                <label for="maxPrice" data-i18n="max_price"></label>
                <input type="number" id="maxPrice" name="maxPrice" class="form-control" min="0">

                <label for="minYear" data-i18n="start_year"></label>
                <input type="number" id="minYear" name="minYear" class="form-control" min="0">

                <label for="maxYear" data-i18n="end_year"></label>
                <input type="number" id="maxYear" name="maxYear" class="form-control" min="0">

                <label for="minMileage" data-i18n="min_mileage"></label>
                <input type="number" id="minMileage" name="minMileage" class="form-control" min="0">

                <label for="maxMileage" data-i18n="max_mileage"></label>
                <input type="number" id="maxMileage" name="maxMileage" class="form-control" min="0">

                <label for="powerType" data-i18n="power_type"></label>
                <select id="powerType" name="powerType" class="form-control" multiple="multiple">
                    <option value="Diesel" data-i18n="diesel"></option>
                    <option value="Bensiini" data-i18n="petrol"></option>
                    <option value="Sähkö" data-i18n="electric"></option>
                    <option value="Hybridi" data-i18n="hybrid"></option>
                </select>

                <label for="gearboxType" data-i18n="gearbox_type"></label>
                <select id="gearboxType" name="gearboxType" class="form-control" multiple="multiple">
                    <option value="Automaatti" data-i18n="automatic"></option>
                    <option value="Manuaali" data-i18n="manual"></option>
                </select>

                <label for="idSearch" data-i18n="vehicle_id"></label>
                <input type="number" id="idSearch" name="idSearch" class="form-control"  min="0" data-i18n="[placeholder]idSearchPlaceholder">  
            </div>
            <button type="submit" class="btn btn-primary mb-2" data-i18n="search_button"></button>
        </form>
    </div>

    <!-- Script for sorting results -->
    <script>
        document.getElementById('sortOrder').addEventListener('change', function () {
            const sortOrderForm = document.getElementById('sortOrderForm');
            const searchParams = new URLSearchParams(window.location.search);

            // Set the new sortOrder in the parameters
            searchParams.set('sortOrder', this.value);

            const brandSelect = document.getElementById('brandSelect');  // Esimerkki: brandin arvo
            if (brandSelect) {
                searchParams.set('brandSelect', brandSelect.value);
            }

            const modelSelect = document.getElementById('modelSelect');  // Esimerkki: mallin arvo
            if (modelSelect) {
                searchParams.set('modelSelect', modelSelect.value);
            }

            const minPrice = document.getElementById('minPrice');  // Esimerkki: minPrice arvo
            if (minPrice) {
                searchParams.set('minPrice', minPrice.value);
            }

            const maxPrice = document.getElementById('maxPrice');  // Esimerkki: minPrice arvo
            if (maxPrice) {
                searchParams.set('maxPrice', maxPrice.value);
            }

            const minYear = document.getElementById('minYear');  // Esimerkki: minPrice arvo
            if (minYear) {
                searchParams.set('minYear', minYear.value);
            }

            const maxYear = document.getElementById('maxYear');  // Esimerkki: minPrice arvo
            if (maxYear) {
                searchParams.set('maxYear', maxYear.value);
            }

            const minMileage = document.getElementById('minMileage');  // Esimerkki: minPrice arvo
            if (minMileage) {
                searchParams.set('minMileage', minMileage.value);
            }

            const maxMileage = document.getElementById('maxMileage');  // Esimerkki: minPrice arvo
            if (maxMileage) {
                searchParams.set('maxMileage', maxMileage.value);
            }

            const powerType= document.getElementById('powerType');  // Esimerkki: minPrice arvo
            if (powerType) {
                searchParams.set('powerType', powerType.value);
            }

            const gearboxType= document.getElementById('gearboxType');  // Esimerkki: minPrice arvo
            if (gearboxType) {
                searchParams.set('gearboxType', gearboxType.value);
            }

            // Update the form's action with all current query parameters
            sortOrderForm.action = `/items/search?${searchParams.toString()}`;

            // Submit the form
            //sortOrderForm.submit();
             window.location.search = searchParams.toString();
        });
    </script>
</body>

</html>